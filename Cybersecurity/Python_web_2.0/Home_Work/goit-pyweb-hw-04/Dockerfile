# 1. Візьмемо базовий образ Python (легку версію slim)
FROM python:3.10-slim

# 2. Вкажеємо робочу папку всередині контейнера
WORKDIR /app

# 3. Скопіюємо всі файли з нашого комп'ютера у контейнер
COPY . /app

# 4. Відкриємо порти 3000 (HTTP) та 5000 (Socket), щоб вони були доступні ззовні
EXPOSE 3000 5000

# 5. Команда, яка запустить нашу програму при старті контейнера
CMD ["python", "main.py"]